POSTGRES_DB=sscre
POSTGRES_USER=sscre
POSTGRES_PASSWORD=change-this-local-password
SSCRE_DATABASE_URL=postgresql://sscre:change-this-local-password@localhost:5432/sscre
SSCRE_SEMANTIC_ENABLED=true
SSCRE_SEMANTIC_STRATEGY=B
SSCRE_SEMANTIC_TOP_K=5
SSCRE_SEMANTIC_SIMILARITY_THRESHOLD=0.95
SSCRE_CACHE_STABLE_TTL_SECONDS=2592000
SSCRE_CACHE_SEMI_DYNAMIC_TTL_SECONDS=86400
SSCRE_CACHE_DYNAMIC_TTL_SECONDS=
SSCRE_CACHE_ALLOW_DYNAMIC_ENTRIES=false
SSCRE_CACHE_MAX_ANSWER_BYTES=65536
SSCRE_CACHE_MAX_METADATA_BYTES=8192
SSCRE_CACHE_MAX_QUERY_BYTES=32768
SSCRE_CACHE_MAX_ENTRIES=10000
SSCRE_CACHE_MAX_BYTES=100000000
