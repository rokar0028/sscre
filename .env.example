POSTGRES_DB=sscre
POSTGRES_USER=sscre
POSTGRES_PASSWORD=change-this-local-password
SSCRE_API_PORT=8000

# External multi-tenant API (Workstream 2). Default trusted_local allows local
# research without client tokens. Set external only with a registry file.
# SSCRE_API_EXPOSURE_MODE=trusted_local
# SSCRE_CLIENT_AUTH_JSON=experiments/client_auth_registry_sample.json
# Required when external: positive rate limit and provider budget (in-process).
# SSCRE_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# SSCRE_TENANT_PROVIDER_BUDGET_PER_MINUTE=60
# SSCRE_TENANT_MAX_CONCURRENT_QUERIES=8
# SSCRE_MAX_REQUEST_BODY_BYTES=65536
SSCRE_POSTGRES_PORT=5432
SSCRE_ADMIN_TOKEN=replace-with-a-long-local-admin-token
SSCRE_ADMIN_READ_TOKEN=
SSCRE_ADMIN_TOKEN_EXPIRES_AT=
SSCRE_ADMIN_READ_TOKEN_EXPIRES_AT=
SSCRE_DATABASE_URL=postgresql://sscre:change-this-local-password@localhost:5432/sscre
SSCRE_RUNTIME_PROFILE=development
SSCRE_LOG_LEVEL=INFO
SSCRE_SEMANTIC_ENABLED=true
SSCRE_SEMANTIC_STRATEGY=C
SSCRE_SEMANTIC_TOP_K=5
SSCRE_SEMANTIC_SIMILARITY_THRESHOLD=0.95
SSCRE_CACHE_STABLE_TTL_SECONDS=2592000
SSCRE_CACHE_SEMI_DYNAMIC_TTL_SECONDS=86400
SSCRE_CACHE_DYNAMIC_TTL_SECONDS=
SSCRE_CACHE_ALLOW_DYNAMIC_ENTRIES=false
SSCRE_CACHE_MAX_ANSWER_BYTES=65536
SSCRE_CACHE_MAX_METADATA_BYTES=8192
SSCRE_CACHE_MAX_QUERY_BYTES=32768
SSCRE_CACHE_MAX_ENTRIES=10000
SSCRE_CACHE_MAX_BYTES=100000000
SSCRE_TIMEOUT_REQUEST_SECONDS=30
SSCRE_TIMEOUT_EMBEDDING_SECONDS=5
SSCRE_TIMEOUT_GENERATION_SECONDS=25
SSCRE_TIMEOUT_REPOSITORY_SECONDS=2
SSCRE_TIMEOUT_HEALTH_SECONDS=1
SSCRE_TIMEOUT_ADMIN_SECONDS=5
